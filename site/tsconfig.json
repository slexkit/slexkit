{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "types": ["bun-types"],
    "skipLibCheck": true,
    "allowJs": true,
    "noEmit": true
  },
  "include": [
    "*.js",
    "*.ts",
    "app/**/*.js",
    "components/**/*.ts",
    "data/**/*.js",
    "markdown/**/*.js",
    "pages/**/*.js",
    "playground/**/*.js",
    "routes/**/*.js",
    "scripts/**/*.ts"
  ]
}
