{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "declaration": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "paths": {
      "slexkit": ["./src/index.ts"],
      "slexkit/runtime": ["./src/runtime.ts"],
      "slexkit/components": ["./src/components/index.ts"],
      "slexkit/components-svelte": ["./src/components-svelte.ts"],
      "slexkit/tooling": ["./src/components/tooling.ts"]
    },
    "outDir": "./dist"
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
