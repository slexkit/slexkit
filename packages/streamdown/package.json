{
  "name": "@slexkit/streamdown",
  "version": "0.4.0",
  "description": "Streamdown custom renderer for SlexKit fenced UI blocks.",
  "author": "SlexKit contributors",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slexkit/slexkit.git",
    "directory": "packages/streamdown"
  },
  "homepage": "https://github.com/slexkit/slexkit/tree/main/packages/streamdown#readme",
  "bugs": {
    "url": "https://github.com/slexkit/slexkit/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./style.css"
  },
  "files": [
    "dist/",
    "style.css",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "./style.css"
  ],
  "scripts": {
    "build": "bun run scripts/build.ts"
  },
  "keywords": [
    "slexkit",
    "streamdown",
    "react",
    "markdown",
    "renderer"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "slexkit": "^0.4.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "streamdown": "^2.5.0"
  },
  "peerDependenciesMeta": {
    "slexkit": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "streamdown": "^2.5.0"
  }
}
