{
  "name": "@slexkit/mcp",
  "version": "0.3.1",
  "description": "Read-only MCP server for SlexKit docs, components, and source validation.",
  "author": "SlexKit contributors",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slexkit/slexkit.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://github.com/slexkit/slexkit/tree/main/packages/mcp#readme",
  "bugs": {
    "url": "https://github.com/slexkit/slexkit/issues"
  },
  "bin": {
    "slexkit-mcp": "dist/index.js"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
